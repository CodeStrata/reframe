{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reframe:v2:schema:common:1",
  "title": "Reframe v2 common definitions",
  "description": "Shared definitions and the record envelope (specification section 6).",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
      "description": "Stable identifier of a record or element."
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utc_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "description": "UTC timestamp, RFC 3339 with Z."
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "urn:reframe:v2:schema:common:1#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "urn:reframe:v2:schema:common:1#/$defs/sha256"
        }
      },
      "required": [
        "content_hash",
        "id",
        "revision"
      ],
      "description": "An exact version of a record: its id, revision and content hash."
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "verified": {
          "type": "boolean",
          "description": "True only for an authenticated identity, such as a GitHub login on feedback. A name given with --by is recorded as stated (section 4, identity)."
        },
        "login": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "verified"
      ]
    },
    "goal": {
      "type": "string",
      "enum": [
        "preserve",
        "modernize"
      ],
      "description": "Section 2: goal per context."
    },
    "interaction_type": {
      "type": "string",
      "enum": [
        "http",
        "event",
        "message",
        "batch",
        "file",
        "in_process"
      ],
      "description": "FR-10: HTTP (OpenAPI), event, message, batch or file exchange, or in-process call."
    },
    "claim_status": {
      "type": "string",
      "enum": [
        "SUPPORTED",
        "PARTIALLY_SUPPORTED",
        "CONTRADICTED",
        "NO_SOURCE_FOUND",
        "NOT_CHECKED"
      ],
      "description": "Section 7."
    },
    "coverage_state": {
      "type": "string",
      "enum": [
        "COVERED",
        "PARTIAL",
        "GAP"
      ],
      "description": "Section 7."
    },
    "readiness_state": {
      "type": "string",
      "enum": [
        "BLOCKED",
        "NEEDS_INPUT",
        "READY_WITH_ACCEPTED_RISKS",
        "READY"
      ],
      "description": "Section 7."
    },
    "source_span": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "end_line",
        "path",
        "start_line"
      ]
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "description": "Every record: what it is, which exact versions it rests on, and its body. content_hash covers schema, record_type, id, depends_on and body.",
      "required": [
        "schema",
        "record_type",
        "id",
        "revision",
        "content_hash",
        "depends_on",
        "body"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^[a-z_]+/[0-9]+$"
        },
        "record_type": {
          "type": "string",
          "enum": [
            "project_policy",
            "source_snapshot",
            "claim_evidence",
            "human_input",
            "context_map",
            "canonical_design",
            "findings_assumptions",
            "operations_ledger",
            "artifact_graph",
            "readiness"
          ]
        },
        "id": {
          "$ref": "urn:reframe:v2:schema:common:1#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "content_hash": {
          "$ref": "urn:reframe:v2:schema:common:1#/$defs/sha256"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "urn:reframe:v2:schema:common:1#/$defs/ref"
          },
          "description": "Exact versions this record rests on."
        },
        "body": {
          "type": "object"
        }
      }
    }
  }
}
