{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reframe:v2:schema:source_snapshot:1",
  "title": "Source snapshot",
  "description": "FR-17: the analysed bytes, pinned by a content manifest and archive hash, with Git or S3 identity, dependency inventory, exclusions and normalization rules.",
  "type": "object",
  "allOf": [
    {
      "$ref": "urn:reframe:v2:schema:common:1#/$defs/envelope"
    }
  ],
  "properties": {
    "schema": {
      "const": "source_snapshot/1"
    },
    "record_type": {
      "const": "source_snapshot"
    },
    "body": {
      "$ref": "#/$defs/body"
    }
  },
  "$defs": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content_manifest": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "urn:reframe:v2:schema:common:1#/$defs/sha256"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path",
              "sha256",
              "size"
            ]
          },
          "description": "Every analysed file."
        },
        "archive_sha256": {
          "$ref": "urn:reframe:v2:schema:common:1#/$defs/sha256"
        },
        "origin": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "git"
                },
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40,64}$"
                },
                "dirty": {
                  "type": "boolean"
                },
                "dirty_paths": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "commit",
                "dirty",
                "dirty_paths",
                "kind",
                "repository"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "s3"
                },
                "bucket": {
                  "type": "string",
                  "minLength": 1
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "version_id": {
                  "type": "string",
                  "minLength": 1
                },
                "checksum": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "bucket",
                "checksum",
                "key",
                "kind",
                "version_id"
              ]
            }
          ]
        },
        "dependency_inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "cobol",
                  "copybook",
                  "bms",
                  "jcl",
                  "cics",
                  "vsam",
                  "db2",
                  "ims",
                  "mq",
                  "other"
                ]
              }
            },
            "required": [
              "kind",
              "path"
            ]
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "reason"
            ]
          }
        },
        "normalization_rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "captured_at": {
          "$ref": "urn:reframe:v2:schema:common:1#/$defs/utc_time"
        }
      },
      "required": [
        "archive_sha256",
        "captured_at",
        "content_manifest",
        "dependency_inventory",
        "exclusions",
        "normalization_rules",
        "origin"
      ]
    }
  }
}
