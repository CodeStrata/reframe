{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reframe:v2:schema:findings_assumptions:1",
  "title": "Findings and assumptions",
  "description": "Section 6 and 7: every open point with its status and disposition.",
  "type": "object",
  "allOf": [
    {
      "$ref": "urn:reframe:v2:schema:common:1#/$defs/envelope"
    }
  ],
  "properties": {
    "schema": {
      "const": "findings_assumptions/1"
    },
    "record_type": {
      "const": "findings_assumptions"
    },
    "body": {
      "$ref": "#/$defs/body"
    }
  },
  "$defs": {
    "body": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "finding"
            },
            "source": {
              "type": "string",
              "enum": [
                "verification",
                "review",
                "merge_conflict",
                "unsupported_construct"
              ]
            },
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "affects": {
              "type": "array",
              "items": {
                "$ref": "urn:reframe:v2:schema:common:1#/$defs/id"
              }
            },
            "disposition": {
              "type": "string",
              "enum": [
                "OPEN",
                "FIXED",
                "ACCEPTED_RISK"
              ]
            },
            "accepted_by": {
              "anyOf": [
                {
                  "$ref": "urn:reframe:v2:schema:common:1#/$defs/person"
                },
                {
                  "type": "null"
                }
              ]
            },
            "accepted_version": {
              "anyOf": [
                {
                  "$ref": "urn:reframe:v2:schema:common:1#/$defs/ref"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "accepted_by",
            "accepted_version",
            "affects",
            "disposition",
            "kind",
            "source",
            "statement"
          ],
          "description": "Section 7. ACCEPTED_RISK names a person and the version they saw."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "assumption"
            },
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "proposed_default": {
              "type": "string",
              "minLength": 1
            },
            "confidence": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "description": "Advisory only."
            },
            "impact": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "owner_role": {
              "type": "string",
              "minLength": 1
            },
            "affected_units": {
              "type": "array",
              "items": {
                "$ref": "urn:reframe:v2:schema:common:1#/$defs/id"
              }
            },
            "decision": {
              "anyOf": [
                {
                  "$ref": "urn:reframe:v2:schema:common:1#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "affected_units",
            "confidence",
            "decision",
            "impact",
            "kind",
            "owner_role",
            "proposed_default",
            "statement"
          ],
          "description": "Section 7: a proposed default is never an implementation rule until decided."
        }
      ]
    }
  }
}
