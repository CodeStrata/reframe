{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reframe:v2:schema:provenance:1",
  "title": "Package provenance",
  "description": "Section 9: reframe/provenance.json records the snapshot, AWS job ids, model backend and region, gate records, versions and hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "snapshot",
    "aws_jobs",
    "model_backend",
    "gates",
    "versions",
    "manifest_sha256"
  ],
  "properties": {
    "schema": {
      "const": "provenance/1"
    },
    "snapshot": {
      "$ref": "urn:reframe:v2:schema:common:1#/$defs/ref"
    },
    "aws_jobs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "model_backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "model_or_profile",
        "configured_destinations",
        "processing_region"
      ],
      "properties": {
        "backend": {
          "enum": [
            "claude-cli",
            "bedrock"
          ]
        },
        "model_or_profile": {
          "type": "string",
          "minLength": 1
        },
        "configured_destinations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "processing_region": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate",
          "state",
          "snapshot",
          "accepted"
        ],
        "properties": {
          "gate": {
            "enum": [
              "gate1",
              "gate2",
              "gate3"
            ]
          },
          "state": {
            "enum": [
              "OPEN",
              "ANSWERED",
              "TIMED_OUT_NO_RESPONSE"
            ]
          },
          "snapshot": {
            "$ref": "urn:reframe:v2:schema:common:1#/$defs/ref"
          },
          "accepted": {
            "anyOf": [
              {
                "$ref": "urn:reframe:v2:schema:common:1#/$defs/ref"
              },
              {
                "type": "null"
              }
            ],
            "description": "The acceptance record, or null: an open or timed-out gate is never an approval."
          }
        }
      }
    },
    "versions": {
      "type": "array",
      "items": {
        "$ref": "urn:reframe:v2:schema:common:1#/$defs/ref"
      }
    },
    "manifest_sha256": {
      "$ref": "urn:reframe:v2:schema:common:1#/$defs/sha256"
    }
  }
}
