{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reframe:v2:schema:resources_file:1",
  "title": "Resources file",
  "description": "FR-02 and section 8: client-owned resources a run uses with --resources. Reframe checks them read-only, never tags, records as its own or deletes them, and writes only under the declared prefixes. The file stays on the engineer's machine; it names an account and is never published.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "resources_file/1"
    },
    "account": {
      "type": "string",
      "pattern": "^[0-9]{12}$"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]$"
    },
    "state_bucket": {
      "$ref": "#/$defs/bucket"
    },
    "bucket": {
      "$ref": "#/$defs/bucket"
    },
    "sandbox_role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+=,.@_-]{1,64}$"
        }
      },
      "required": [
        "name"
      ]
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "assessment_connector": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reimagine_connector": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "workspace_id",
        "assessment_connector",
        "reimagine_connector"
      ]
    },
    "neptune_stack": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9-]{0,127}$"
        }
      },
      "required": [
        "name"
      ]
    }
  },
  "required": [
    "schema",
    "account",
    "region",
    "state_bucket",
    "bucket",
    "sandbox_role",
    "transform",
    "neptune_stack"
  ],
  "$defs": {
    "bucket": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
        },
        "write_prefixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9!_.*'()-]+(/[A-Za-z0-9!_.*'()-]+)*/$",
            "not": {
              "pattern": "(^|/)\\.{1,2}/"
            },
            "description": "A key prefix ending in '/'; no '.' or '..' segments."
          }
        }
      },
      "required": [
        "name",
        "write_prefixes"
      ]
    }
  }
}
