{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reframe:v2:schema:human_input:1",
  "title": "Human input",
  "description": "Section 6 and FR-18: gate context, feedback items, decisions and acceptances, each with author, channel and the version it binds to. Under the single-operator model a decision is recorded by the operator on someone's behalf.",
  "type": "object",
  "allOf": [
    {
      "$ref": "urn:reframe:v2:schema:common:1#/$defs/envelope"
    }
  ],
  "properties": {
    "schema": {
      "const": "human_input/1"
    },
    "record_type": {
      "const": "human_input"
    },
    "body": {
      "$ref": "#/$defs/body"
    }
  },
  "$defs": {
    "body": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "context"
            },
            "gate": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "gate1",
                    "gate2",
                    "gate3"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "for_ids": {
              "type": "array",
              "items": {
                "$ref": "urn:reframe:v2:schema:common:1#/$defs/id"
              }
            },
            "author": {
              "$ref": "urn:reframe:v2:schema:common:1#/$defs/person"
            },
            "recorded_by": {
              "type": "string",
              "minLength": 1
            },
            "channel": {
              "type": "string",
              "enum": [
                "cli",
                "github",
                "local_file"
              ]
            },
            "recorded_at": {
              "$ref": "urn:reframe:v2:schema:common:1#/$defs/utc_time"
            }
          },
          "required": [
            "author",
            "channel",
            "for_ids",
            "gate",
            "kind",
            "recorded_at",
            "recorded_by",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "feedback"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "affected_ids": {
              "type": "array",
              "items": {
                "$ref": "urn:reframe:v2:schema:common:1#/$defs/id"
              }
            },
            "external_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "disposition": {
              "type": "string",
              "enum": [
                "open",
                "accepted",
                "rejected",
                "rebased",
                "refused_stale"
              ]
            },
            "author": {
              "$ref": "urn:reframe:v2:schema:common:1#/$defs/person"
            },
            "recorded_by": {
              "type": "string",
              "minLength": 1
            },
            "channel": {
              "type": "string",
              "enum": [
                "cli",
                "github",
                "local_file"
              ]
            },
            "recorded_at": {
              "$ref": "urn:reframe:v2:schema:common:1#/$defs/utc_time"
            }
          },
          "required": [
            "affected_ids",
            "author",
            "channel",
            "disposition",
            "external_ref",
            "kind",
            "recorded_at",
            "recorded_by",
            "text"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "decision"
            },
            "subject": {
              "$ref": "urn:reframe:v2:schema:common:1#/$defs/id"
            },
            "outcome": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "binds_to": {
              "$ref": "urn:reframe:v2:schema:common:1#/$defs/ref"
            },
            "author": {
              "$ref": "urn:reframe:v2:schema:common:1#/$defs/person"
            },
            "recorded_by": {
              "type": "string",
              "minLength": 1
            },
            "channel": {
              "type": "string",
              "enum": [
                "cli",
                "github",
                "local_file"
              ]
            },
            "recorded_at": {
              "$ref": "urn:reframe:v2:schema:common:1#/$defs/utc_time"
            }
          },
          "required": [
            "author",
            "binds_to",
            "channel",
            "kind",
            "outcome",
            "reason",
            "recorded_at",
            "recorded_by",
            "subject"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "acceptance"
            },
            "gate": {
              "type": "string",
              "enum": [
                "gate1",
                "gate2",
                "gate3",
                "package"
              ]
            },
            "binds_to": {
              "$ref": "urn:reframe:v2:schema:common:1#/$defs/ref"
            },
            "after_timeout": {
              "type": "boolean"
            },
            "author": {
              "$ref": "urn:reframe:v2:schema:common:1#/$defs/person"
            },
            "recorded_by": {
              "type": "string",
              "minLength": 1
            },
            "channel": {
              "type": "string",
              "enum": [
                "cli",
                "github",
                "local_file"
              ]
            },
            "recorded_at": {
              "$ref": "urn:reframe:v2:schema:common:1#/$defs/utc_time"
            }
          },
          "required": [
            "after_timeout",
            "author",
            "binds_to",
            "channel",
            "gate",
            "kind",
            "recorded_at",
            "recorded_by"
          ],
          "description": "A named person's acceptance of an exact version (section 4, reframe accept)."
        }
      ]
    }
  }
}
