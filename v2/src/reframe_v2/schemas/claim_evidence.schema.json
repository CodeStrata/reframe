{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reframe:v2:schema:claim_evidence:1",
  "title": "Claim and evidence",
  "description": "Section 6 and 7: AWS requirements and rules, evidence records, coverage.",
  "type": "object",
  "allOf": [
    {
      "$ref": "urn:reframe:v2:schema:common:1#/$defs/envelope"
    }
  ],
  "properties": {
    "schema": {
      "const": "claim_evidence/1"
    },
    "record_type": {
      "const": "claim_evidence"
    },
    "body": {
      "$ref": "#/$defs/body"
    }
  },
  "$defs": {
    "body": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "claim"
            },
            "source": {
              "type": "string",
              "enum": [
                "aws_transform",
                "reframe"
              ]
            },
            "claim_kind": {
              "type": "string",
              "enum": [
                "rule",
                "requirement",
                "behaviour"
              ]
            },
            "statement": {
              "type": "string",
              "minLength": 1
            },
            "original": {
              "anyOf": [
                {
                  "$ref": "urn:reframe:v2:schema:common:1#/$defs/ref"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "$ref": "urn:reframe:v2:schema:common:1#/$defs/claim_status"
            }
          },
          "required": [
            "claim_kind",
            "kind",
            "original",
            "source",
            "statement",
            "status"
          ],
          "description": "One statement about the source (section 2). Status starts NOT_CHECKED for AWS claims."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "evidence"
            },
            "claim": {
              "$ref": "urn:reframe:v2:schema:common:1#/$defs/id"
            },
            "source_artifact_hash": {
              "$ref": "urn:reframe:v2:schema:common:1#/$defs/sha256"
            },
            "source_span": {
              "anyOf": [
                {
                  "$ref": "urn:reframe:v2:schema:common:1#/$defs/source_span"
                },
                {
                  "type": "null"
                }
              ]
            },
            "dependencies_checked": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "$ref": "urn:reframe:v2:schema:common:1#/$defs/sha256"
                  }
                },
                "required": [
                  "kind",
                  "path",
                  "sha256"
                ]
              }
            },
            "citation_exists": {
              "type": "boolean"
            },
            "result": {
              "$ref": "urn:reframe:v2:schema:common:1#/$defs/claim_status"
            },
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "limits": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "citation_exists",
            "claim",
            "dependencies_checked",
            "kind",
            "limits",
            "result",
            "reviewer",
            "source_artifact_hash",
            "source_span"
          ],
          "description": "Section 7: the check of one claim. Citation existence and semantic support are separate (FR-06). NO_SOURCE_FOUND has no span."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "coverage"
            },
            "unit_kind": {
              "type": "string",
              "enum": [
                "function",
                "program"
              ]
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "$ref": "urn:reframe:v2:schema:common:1#/$defs/coverage_state"
            },
            "extraction": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "generated",
                    "failed",
                    "unsupported",
                    "excluded",
                    "awaiting_selection"
                  ],
                  "description": "FR-03."
                },
                {
                  "type": "null"
                }
              ]
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "extraction",
            "kind",
            "notes",
            "state",
            "unit",
            "unit_kind"
          ],
          "description": "Section 7: coverage is separate from claim status."
        }
      ]
    }
  }
}
