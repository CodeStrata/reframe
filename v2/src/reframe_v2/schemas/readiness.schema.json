{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reframe:v2:schema:readiness:1",
  "title": "Readiness",
  "description": "Section 7 and FR-19: per unit, the computed state, its blockers by id and why.",
  "type": "object",
  "allOf": [
    {
      "$ref": "urn:reframe:v2:schema:common:1#/$defs/envelope"
    }
  ],
  "properties": {
    "schema": {
      "const": "readiness/1"
    },
    "record_type": {
      "const": "readiness"
    },
    "body": {
      "$ref": "#/$defs/body"
    }
  },
  "$defs": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": {
          "$ref": "urn:reframe:v2:schema:common:1#/$defs/id"
        },
        "state": {
          "$ref": "urn:reframe:v2:schema:common:1#/$defs/readiness_state"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "urn:reframe:v2:schema:common:1#/$defs/id"
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "kind",
              "reason"
            ]
          }
        },
        "package_complete": {
          "type": "boolean"
        }
      },
      "required": [
        "blockers",
        "package_complete",
        "state",
        "unit"
      ]
    }
  }
}
